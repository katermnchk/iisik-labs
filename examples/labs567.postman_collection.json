          "mode": "raw",
          "raw": "{\n  \"query\": \"{salesAnalytics(filter:{from:\\\"2026-01-01T00:00:00Z\\\",to:\\\"2031-01-01T00:00:00Z\\\"}){grossSales{amountMinor}occupancy}}\",\n  \"variables\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const started = Date.now();",
              "const ready = a => !a.errors && (BigInt(a.data.salesAnalytics.grossSales.amountMinor)>=BigInt(pm.collectionVariables.get('salesBefore'))+BigInt(pm.collectionVariables.get('expectedAmount')));",
              "const projectionRequest = {url: pm.variables.replaceIn(pm.request.url.toString()), method:'POST', header:pm.request.headers.all().map(h=>({key:h.key,value:pm.variables.replaceIn(h.value)})), body:{mode:'raw',raw:pm.variables.replaceIn(pm.request.body.raw)}};",
              "function inspect(a) {",
              " if (ready(a)) { pm.test('Оплата включена в продажи',()=>pm.expect(ready(a)).to.equal(true)); return; }",
              " if (Date.now()-started >= 20000) { pm.test('Оплата включена в продажи за 20 секунд',()=>pm.expect(JSON.stringify(a),'Асинхронная проекция не обновилась').to.equal('READY')); return; }",
              " setTimeout(()=>pm.sendRequest(projectionRequest,(error,response)=> { if(error) {pm.test('Повторный запрос доступен',()=>pm.expect(error).to.equal(null));return;} inspect(response.json());}),500);",
              "}",
              "inspect(pm.response.json());"
            ]
          }
        }
      ]
