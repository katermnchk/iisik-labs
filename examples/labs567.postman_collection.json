        "exec": [
          "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
          "const response=pm.response.json();",
          "const expected=pm.info.requestName.includes('ожидается запрет')?'FORBIDDEN':pm.info.requestName.includes('ожидается отказ')?'UNAUTHENTICATED':null;",
          "pm.test(expected || 'GraphQL без ошибок',()=> {if(expected)pm.expect(response.errors[0].extensions.code).to.equal(expected);else pm.expect(response.errors).to.be.undefined;});"
