    {
      "name": "Kafka: дождаться CONFIRMED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{clientToken}}"
          }
        ],
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query($id:ID!){booking(id:$id){id status payments{id status}}}\",\n  \"variables\": {\n    \"id\": \"{{bookingId}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const started = Date.now();",
              "const ready = a => !a.errors && (a.data.booking.status==='CONFIRMED' && a.data.booking.payments.some(p=>p.id===pm.collectionVariables.get('paymentId') && p.status==='SUCCEEDED'));",
              "const projectionRequest = {url: pm.variables.replaceIn(pm.request.url.toString()), method:'POST', header:pm.request.headers.all().map(h=>({key:h.key,value:pm.variables.replaceIn(h.value)})), body:{mode:'raw',raw:pm.variables.replaceIn(pm.request.body.raw)}};",
              "function inspect(a) {",
              " if (ready(a)) { pm.test('Бронь подтверждена Kafka',()=>pm.expect(ready(a)).to.equal(true)); return; }",
              " if (Date.now()-started >= 20000) { pm.test('Бронь подтверждена Kafka за 20 секунд',()=>pm.expect(JSON.stringify(a),'Асинхронная проекция не обновилась').to.equal('READY')); return; }",
              " setTimeout(()=>pm.sendRequest(projectionRequest,(error,response)=> { if(error) {pm.test('Повторный запрос доступен',()=>pm.expect(error).to.equal(null));return;} inspect(response.json());}),500);",
              "}",
              "inspect(pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "Уведомления",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
