        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"{notifications(page:{page:0,size:100}){totalCount items{id title body}}}\",\n  \"variables\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const started = Date.now();",
              "const ready = a => !a.errors && (a.data.notifications.items.some(n=>n.body===pm.collectionVariables.get('tourTitle') && n.title.includes('CONFIRMED')));",
              "const projectionRequest = {url: pm.variables.replaceIn(pm.request.url.toString()), method:'POST', header:pm.request.headers.all().map(h=>({key:h.key,value:pm.variables.replaceIn(h.value)})), body:{mode:'raw',raw:pm.variables.replaceIn(pm.request.body.raw)}};",
              "function inspect(a) {",
              " if (ready(a)) { pm.test('Уведомление текущей брони создано',()=>pm.expect(ready(a)).to.equal(true)); return; }",
              " if (Date.now()-started >= 20000) { pm.test('Уведомление текущей брони создано за 20 секунд',()=>pm.expect(JSON.stringify(a),'Асинхронная проекция не обновилась').to.equal('READY')); return; }",
              " setTimeout(()=>pm.sendRequest(projectionRequest,(error,response)=> { if(error) {pm.test('Повторный запрос доступен',()=>pm.expect(error).to.equal(null));return;} inspect(response.json());}),500);",
              "}",
              "inspect(pm.response.json());"
            ]
          }
        }
